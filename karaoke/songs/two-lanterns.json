  {
   "t": 5.2174,
   "text": "I lit a lantern by the shore",
   "part": 1
  },
  {
   "t": 10.4348,
   "text": "I saw it shining from my door",
   "part": 2
  },
  {
   "t": 15.6522,
   "text": "So I walked out across the sand",
   "part": 1
  },
  {
   "t": 20.8696,
   "text": "And met you halfway, hand in hand",
   "part": 2
  },
  {
   "t": 26.087,
   "text": "Two lanterns burning in the night",
   "part": "both"
  },
  {
   "t": 31.3043,
   "text": "Together we can make it bright",
   "part": "both"
  },
  {
   "t": 36.5217,
   "text": "The wind came rolling off the bay",
   "part": 2
  },
  {
